    {
      "name": "150 g scales macros and micros while preserving zero",
      "fn": "entryNutrients",
      "args": [
        {
          "id": "synthetic-entry",
          "grams": 150
        },
        {
          "kcal": 100,
          "protein_g": 10,
          "carbs_g": 20,
          "fat_g": 5,
          "micros": {
            "sodio_mg": 50,
            "magnesio_mg": 0,
            "calcio_mg": null
          }
        }
      ],
      "expected": {
        "id": "synthetic-entry",
        "grams": 150,
        "item": null,
        "brand": null,
        "meal": null,
        "sort_order": null,
        "kcal": 150,
        "protein_g": 15,
        "carbs_g": 30,
        "fat_g": 7.5,
        "micros": {
          "sodio_mg": 75,
          "magnesio_mg": 0
        },
        "micros_complete": {
          "sodio_mg": true,
          "magnesio_mg": true
        }
      }
    },
