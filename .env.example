VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Opcional: monitoreo de errores en producción (Sentry). DSN publicable — se expone
# en el bundle cliente. Solo activo en build de producción; añadir también en Vercel.
# VITE_SENTRY_DSN=
# Claves opcionales para llamadas directas en desarrollo local y evaluaciones.
# VITE_GEMINI_KEY=
# VITE_MISTRAL_KEY=
# VITE_FDC_KEY=
# En producción configura GEMINI_KEY, MISTRAL_KEY y FDC_KEY solo en el entorno
# de las funciones de Vercel. El cliente utiliza /api/ai con el JWT de la cuenta.
# Detalles de configuración y proveedores: docs/DATOS-E-INTEGRACIONES.md

# Opcional, SOLO dev local: auto-login de la cuenta de pruebas para verificación
# autónoma por IA (abrir http://localhost:5173/?dev=1). Nunca en Vercel.
# VITE_DEV_EMAIL=
# VITE_DEV_PASSWORD=
